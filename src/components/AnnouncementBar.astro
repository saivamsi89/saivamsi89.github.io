---
// Scrolling announcement ticker above the main navigation. Dismissal is
// remembered per announcementVersion (src/data/home.ts).
import Icon from './Icon.astro';
import { announcements, announcementVersion } from '@/data/home';
---
{announcements.length > 0 && (
  <div id="announce" class="announce on-dark relative bg-ink-950 text-fg-muted" data-version={announcementVersion} role="region" aria-label="Announcements">
    <div class="flex h-9 items-center">
      <div class="ticker relative isolate flex-1 overflow-hidden">
        <ul class="ticker-track flex w-max items-center">
          {[...announcements, ...announcements].map((a, i) => (
            <li class="flex items-center" aria-hidden={i >= announcements.length ? 'true' : undefined}>
              <a href={a.href} class="group flex min-h-9 items-center gap-2.5 px-6 text-xs-plus whitespace-nowrap hover:text-fg" tabindex={i >= announcements.length ? -1 : undefined}>
                {a.tag && <span class="rounded bg-signal-400/15 px-1.5 py-0.5 font-mono text-[0.6rem] font-semibold tracking-wider text-signal-300 uppercase">{a.tag}</span>}
                {a.text}
                <Icon name="ArrowRight" class="size-3 opacity-50 transition group-hover:translate-x-0.5 group-hover:opacity-100" />
              </a>
              <span class="text-copper-500/70" aria-hidden="true">◆</span>
            </li>
          ))}
        </ul>
      </div>
      <button type="button" class="announce-close relative z-10 mx-2 inline-flex size-8 shrink-0 bg-ink-950 items-center justify-center rounded-md text-fg-subtle hover:bg-white/10 hover:text-white" aria-label="Dismiss announcements">
        <Icon name="X" class="size-4" />
      </button>
    </div>
  </div>
)}
<style>
  .ticker { mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent); }
  .ticker-track { animation: ticker 60s linear infinite; }
  .ticker:hover .ticker-track, .ticker:focus-within .ticker-track { animation-play-state: paused; }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } .ticker { overflow-x: auto; } }
  :global(html.announce-off) .announce { display: none; }
</style>
<script>
  const bar = document.getElementById('announce');
  bar?.querySelector('.announce-close')?.addEventListener('click', () => {
    document.documentElement.classList.add('announce-off');
    try { localStorage.setItem('nf-announce', bar.dataset.version!); } catch {}
  });
</script>
