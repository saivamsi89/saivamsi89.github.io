---
// Numbered process rendered as a connected trace (like a PCB net).
import Icon from './Icon.astro';
interface Props { steps: { title: string; icon?: string }[]; dark?: boolean }
const { steps, dark = false } = Astro.props;
const cols = steps.length > 6 ? 'lg:grid-cols-4' : 'lg:grid-cols-3';
---
<ol class:list={['relative grid gap-4 sm:grid-cols-2', cols]}>
  {steps.map((s, i) => (
    <li
      data-reveal
      class:list={[
        'group relative overflow-hidden rounded-card border p-6 transition',
        dark ? 'border-white/10 bg-white/[0.03] hover:border-signal-400/40' : 'border-line bg-surface hover:border-signal-500/50',
      ]}
    >
      <div class="flex items-center justify-between">
        <span class:list={['font-mono text-sm font-semibold', dark ? 'text-copper-400' : 'text-accent-2']}>
          {String(i + 1).padStart(2, '0')}
        </span>
        {s.icon && <span class="icon-tile size-10"><Icon name={s.icon} class="size-5" /></span>}
      </div>
      <h3 class:list={['mt-5 text-base font-semibold', dark ? 'text-white' : 'text-fg']}>{s.title}</h3>
      <span
        class:list={['absolute bottom-0 left-0 h-0.5 w-0 transition-all duration-500 group-hover:w-full', dark ? 'bg-signal-400' : 'bg-signal-500']}
        aria-hidden="true"
      ></span>
    </li>
  ))}
</ol>
