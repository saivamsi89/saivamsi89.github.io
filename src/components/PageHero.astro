---
// Inner-page banner, styled like the home banner slides. With `art` (or `image`) it
// becomes a two-column, picture-led banner; without, a compact text banner.
import SlideArt from './home/SlideArt.astro';
import { Image } from 'astro:assets';
import { heroPhoto } from '@/lib/assets';
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  art?: 'showcase' | 'boards' | 'iot' | 'lighting' | 'assembly';
  photo?: string; // file in src/assets/hero/, listed in data/credits.ts
}
const { eyebrow, title, lead, crumbs = [], art, photo } = Astro.props;
const pictured = !!(art || photo);
---
<section class="page-hero on-dark bg-grad-hero relative isolate overflow-hidden">
  <div class="bg-grid mask-fade absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
  {photo && (
    <div class="page-photo absolute inset-y-0 right-0 -z-10 hidden w-[58%] lg:block" aria-hidden="true">
      <Image src={heroPhoto(photo)!} alt="" widths={[960, 1440, 1920]} sizes="58vw" loading="eager" class="size-full object-cover" />
    </div>
  )}
  <div class:list={['container-x relative pt-36 sm:pt-40', pictured ? 'grid items-center gap-8 pb-12 lg:grid-cols-12 lg:gap-10 lg:pb-16' : 'pb-16 sm:pb-20']}>
    <div class:list={[pictured && 'lg:col-span-7']}>
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-6 font-mono text-xs text-fg-subtle">
          <a href="/" class="hover:text-white">Home</a>
          {crumbs.map((c) => (
            <>
              <span class="mx-2 text-fg-muted">/</span>
              {c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span class="text-fg-muted">{c.label}</span>}
            </>
          ))}
        </nav>
      )}
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h-display mt-4 max-w-4xl text-white" set:html={title} />
      {lead && <p class="lead mt-6 max-w-2xl">{lead}</p>}
      <slot />
    </div>
    {pictured && (
      <div class="relative h-64 sm:h-80 lg:col-span-5 lg:h-[26rem]">
        {photo
          ? <Image src={heroPhoto(photo)!} alt="" widths={[640, 960]} sizes="100vw" class="size-full rounded-panel object-cover lg:hidden" />
          : <SlideArt name={art!} />}
      </div>
    )}
  </div>
</section>
<style>
  .page-photo { mask-image: linear-gradient(to right, transparent 0%, black 40%); }
  .page-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(26 0 10 / .35), rgb(26 0 10 / .15) 50%, rgb(26 0 10 / .5)); }
</style>
