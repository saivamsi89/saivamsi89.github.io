---
// Cookie banner with an optional, clearly consented email field. It appears when
// visitor-email collection (Bluehost build) or Google Analytics is switched on.
const ga = (import.meta.env.PUBLIC_ANALYTICS ?? '').toLowerCase() === 'ga4' && !!import.meta.env.PUBLIC_GA4_ID;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const askEmail = import.meta.env.PUBLIC_VISITOR_EMAIL === '1' && !!endpoint;
const enabled = ga || askEmail;
---
{enabled && (
  <div id="consent" class="fixed inset-x-3 bottom-3 z-[70] mx-auto hidden max-w-3xl rounded-card border border-line bg-surface p-5 shadow-2xl shadow-ink-950/30 sm:inset-x-6 sm:bottom-6" role="dialog" aria-labelledby="consent-title" data-endpoint={askEmail ? endpoint : ''}>
    <p id="consent-title" class="font-semibold text-fg">Cookies</p>
    <p class="mt-1 text-sm text-fg-muted">
      We use cookies and browser storage to remember your choices{ga ? ' and, if you accept, Google Analytics to understand how the site is used' : ''}. See our <a href="/privacy-policy#cookies" class="text-accent underline">Privacy Policy</a>.
    </p>
    {askEmail && (
      <div class="mt-3">
        <label for="consent-email" class="field-label">Your email (optional)</label>
        <input id="consent-email" type="email" class="field field-sm" autocomplete="email" placeholder="you@company.com" aria-describedby="consent-note" />
        <p id="consent-note" class="mt-1.5 text-xs text-fg-subtle">Only if you want us to contact you: by entering it and choosing Accept, you agree that Nanofab may store it and email you. You can ask us to delete it at any time.</p>
        <p class="consent-error mt-1.5 hidden text-xs font-semibold text-accent" role="alert">Please enter a valid email address, or leave the box empty.</p>
      </div>
    )}
    <div class="mt-4 flex justify-end gap-2">
      <button type="button" data-consent="denied" class="btn btn-outline btn-sm">Decline</button>
      <button type="button" data-consent="granted" class="btn btn-primary btn-sm">Accept</button>
    </div>
  </div>
)}
<script>
  const box = document.getElementById('consent');
  if (box) {
    const get = () => { try { return localStorage.getItem('nf-consent'); } catch { return null; } };
    const open = () => box.classList.remove('hidden');
    if (!get()) open();
    box.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
      b.addEventListener('click', () => {
        const v = b.dataset.consent!;
        const input = box.querySelector<HTMLInputElement>('#consent-email');
        const email = input?.value.trim() ?? '';
        if (v === 'granted' && email) {
          if (!input!.checkValidity()) { box.querySelector('.consent-error')!.classList.remove('hidden'); input!.focus(); return; }
          const data = new FormData();
          data.set('form', 'Visitor email'); data.set('email', email); data.set('consent', 'yes'); data.set('page', location.pathname);
          fetch(box.dataset.endpoint!, { method: 'POST', body: data }).catch(() => {});
        }
        try { localStorage.setItem('nf-consent', v); } catch {}
        box.classList.add('hidden');
        if (v === 'granted') (window as any).nfLoadGA?.();
        else if ((window as any).__gaLoaded) location.reload(); // stop an already-loaded GA session
      }),
    );
    document.querySelectorAll('[data-cookie-settings]').forEach((el) => el.addEventListener('click', (e) => { e.preventDefault(); open(); }));
  }
</script>
