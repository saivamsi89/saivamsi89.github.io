---
import * as icons from 'lucide-static';

interface Props { name: string; class?: string; strokeWidth?: number }
const { name, class: cls = 'size-5', strokeWidth = 1.75 } = Astro.props;
const raw = (icons as Record<string, string>)[name];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw
  .replace(/class="[^"]*"/, `class="${cls}" aria-hidden="true" focusable="false"`)
  .replace(/stroke-width="[^"]*"/, `stroke-width="${strokeWidth}"`)
  .replace(/\swidth="24"/, '')
  .replace(/\sheight="24"/, '');
---
<Fragment set:html={svg} />
