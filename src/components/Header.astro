---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import AnnouncementBar from './AnnouncementBar.astro';
import { nav as allNav } from '@/data/site';
import { getCaseStudies, getTeam } from '@/lib/content';
// Hide links to sections that have no published content yet.
const hidden = new Set<string>();
if (!(await getCaseStudies()).length) hidden.add('/case-studies');
if (!(await getTeam()).length) hidden.add('/team');
const nav = allNav.map((i) => ({ ...i, children: i.children?.filter((c) => !hidden.has(c.href)) }));

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const matches = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const activeHref = nav.map((i) => i.href).filter(matches).sort((a, b) => b.length - a.length)[0];
const isActive = (href: string) => href === activeHref;
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300" data-scrolled="false">
  <AnnouncementBar />
  <div class="container-x flex h-18 items-center justify-between gap-6">
    <a href="/" class="logo-link">
      <Logo />
      <span class="sr-only">Home</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-0.5 xl:gap-1">
        {nav.map((item) => (
          <li class="group relative">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={['nav-link inline-flex items-center gap-1 rounded-md px-2.5 py-2 text-sm font-medium whitespace-nowrap transition xl:px-3', isActive(item.href) && 'is-active']}
            >
              {item.label}
              {item.children && <Icon name="ChevronDown" class="size-3.5 opacity-70 transition group-hover:rotate-180" />}
            </a>
            {item.children && (
              <div class="invisible absolute top-full left-1/2 w-80 -translate-x-1/2 pt-3 opacity-0 transition duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <ul class="rounded-card border border-line bg-surface p-2 shadow-2xl shadow-ink-900/10">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class="block rounded-xl px-4 py-3 transition hover:bg-surface-2">
                        <span class="block text-sm font-semibold text-fg">{c.label}</span>
                        {c.desc && <span class="block text-xs text-fg-subtle">{c.desc}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
      <button
        id="menu-toggle"
        type="button"
        class="menu-btn inline-flex size-10 items-center justify-center rounded-control lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="icon-open"><Icon name="Menu" class="size-6" /></span>
        <span class="icon-close hidden"><Icon name="X" class="size-6" /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-line bg-surface lg:hidden">
    <nav aria-label="Mobile" class="container-x py-4">
      <ul class="divide-y divide-line">
        {nav.map((item) => (
          <li class="py-1">
            <a href={item.href} class="block py-2.5 text-base font-semibold text-fg">{item.label}</a>
            {item.children && (
              <ul class="mb-2 grid gap-0.5 border-l-2 border-signal-500/30 pl-4">
                {item.children.map((c) => (
                  <li><a href={c.href} class="block py-1.5 text-sm text-fg-muted">{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Always a white bar, so the logo appears exactly as supplied. */
  #site-header { background: var(--color-surface); box-shadow: 0 1px 0 var(--color-line); }
  #site-header[data-scrolled='true'] { box-shadow: 0 4px 16px -8px rgb(17 5 43 / 0.25); }
  .nav-link { color: var(--color-fg-muted); transition: color .3s, background-color .2s; }
  .nav-link:hover, .nav-link.is-active { color: var(--color-fg); background: color-mix(in srgb, var(--color-fg) 8%, transparent); }
  .menu-btn { color: var(--color-fg); transition: color .3s, background-color .2s; }
  .menu-btn:hover { background: color-mix(in srgb, var(--color-fg) 8%, transparent); }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const onScroll = () => header.setAttribute('data-scrolled', String(window.scrollY > 24));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    header.setAttribute('data-open', String(open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.icon-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')!.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
