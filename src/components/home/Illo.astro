---
// Small brand illustrations (line-art, brand colours) used in the bento grid.
interface Props { name: 'stack' | 'firmware' | 'wireless' | 'reel' | 'schematic'; class?: string }
const { name, class: cls = '' } = Astro.props;
---
<div class:list={['illo', cls]} aria-hidden="true">
  {name === 'stack' && (
    <svg viewBox="0 0 320 200" class="h-full w-full">
      {[0, 1, 2, 3].map((i) => (
        <g transform={`translate(0 ${i * -26})`} class="lyr" style={`--i:${i}`}>
          <path d="M160 150 L290 110 L160 70 L30 110 Z" fill={['#11052b', '#381972', '#b57c34', '#087a0a'][i]} fill-opacity={[1, 1, 0.55, 0.45][i]}
            stroke={['#4f2d94', '#4f2d94', '#e8b87a', '#2fd932'][i]} stroke-width="1.4" />
        </g>
      ))}
      <g transform="translate(0 -78)" stroke="#7ee881" stroke-width="1.6" fill="none" stroke-linecap="round">
        <path d="M110 112 L150 100 L190 112" /><path d="M120 122 L170 107 L230 125" /><circle cx="150" cy="100" r="3" fill="#7ee881" /><circle cx="230" cy="125" r="3" fill="#7ee881" />
      </g>
      <text x="160" y="196" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="#6f6d8e">TOP · L2 · L3 · BOTTOM</text>
    </svg>
  )}
  {name === 'firmware' && (
    <svg viewBox="0 0 200 200" class="h-full w-full">
      <rect x="60" y="60" width="80" height="80" rx="10" fill="#27105a" stroke="#2fd932" stroke-opacity=".7" />
      {[0, 1, 2, 3].map((i) => (
        <>
          <path d={`M${74 + i * 17} 60 V44`} stroke="#a9a7c2" stroke-width="3" /><path d={`M${74 + i * 17} 140 V156`} stroke="#a9a7c2" stroke-width="3" />
          <path d={`M60 ${74 + i * 17} H44`} stroke="#a9a7c2" stroke-width="3" /><path d={`M140 ${74 + i * 17} H156`} stroke="#a9a7c2" stroke-width="3" />
        </>
      ))}
      <text x="100" y="108" text-anchor="middle" font-family="var(--font-mono)" font-size="22" font-weight="600" fill="#7ee881">{'{ }'}</text>
      <rect x="14" y="166" width="120" height="6" rx="3" fill="#381972" /><rect x="14" y="166" width="84" height="6" rx="3" fill="#2fd932" class="bar" />
    </svg>
  )}
  {name === 'wireless' && (
    <svg viewBox="0 0 200 120" class="h-full w-full">
      <rect x="84" y="66" width="32" height="40" rx="6" fill="#27105a" stroke="#2fd932" stroke-opacity=".7" /><circle cx="100" cy="80" r="4" fill="#2fd932" />
      {[22, 40, 58].map((r, i) => <path d={`M${100 - r} ${70 - r * 0.25} A ${r} ${r} 0 0 1 ${100 + r} ${70 - r * 0.25}`} fill="none" stroke="#2fd932" stroke-width="2.4" stroke-linecap="round" class="arc" style={`--i:${i}`} />)}
      {[[20, 96], [180, 96], [40, 30], [160, 30]].map(([x, y]) => <circle cx={x} cy={y} r="5" fill="none" stroke="#e8b87a" stroke-width="2" />)}
    </svg>
  )}
  {name === 'reel' && (
    <svg viewBox="0 0 200 120" class="h-full w-full">
      <circle cx="60" cy="60" r="44" fill="none" stroke="#4f2d94" stroke-width="2" /><circle cx="60" cy="60" r="30" fill="none" stroke="#4f2d94" stroke-width="6" stroke-dasharray="4 6" class="spin" /><circle cx="60" cy="60" r="8" fill="#381972" />
      <path d="M100 60 H190" stroke="#4f2d94" stroke-width="14" />
      {[0, 1, 2, 3, 4].map((i) => <rect x={108 + i * 17} y="55" width="9" height="10" rx="1.5" fill="#e8b87a" />)}
    </svg>
  )}
  {name === 'schematic' && (
    <svg viewBox="0 0 200 120" class="h-full w-full" fill="none" stroke="#7ee881" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 60 H40 l6 -12 l12 24 l12 -24 l12 24 l6 -12 H120" />
      <path d="M120 40 V80 M132 40 V80" /><path d="M132 60 H190" />
      <path d="M160 60 V90 M150 90 H170 M154 96 H166 M158 102 H162" stroke="#e8b87a" />
      <circle cx="10" cy="60" r="3" fill="#7ee881" /><circle cx="190" cy="60" r="3" fill="#7ee881" />
    </svg>
  )}
</div>
<style>
  .lyr { transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  :global(.group:hover) .lyr { transform: translateY(calc(var(--i) * -34px)); }
  .bar { transform-origin: left; animation: fill 3s ease-in-out infinite; }
  .arc { animation: arc 2.2s ease-in-out infinite; animation-delay: calc(var(--i) * .25s); }
  .spin { transform-origin: 60px 60px; animation: spin 8s linear infinite; }
  @keyframes fill { 0%, 100% { transform: scaleX(.2) } 60% { transform: scaleX(1) } }
  @keyframes arc { 0%, 100% { opacity: .25 } 50% { opacity: 1 } }
  @keyframes spin { to { transform: rotate(360deg) } }
  @media (prefers-reduced-motion: reduce) { .bar, .arc, .spin { animation: none; } .lyr { transition: none; } }
</style>
