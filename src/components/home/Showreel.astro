---
// Featured video with a modal player.
import Icon from '../Icon.astro';
---
<section class="cv-auto section on-dark relative overflow-hidden bg-ink-950" data-spotlight>
  <div class="bg-grid absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="container-x relative grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow">See how we build</p>
      <h2 class="h-section mt-3 text-white">Engineering you can see.</h2>
      <p class="lead mt-5">From the first block diagram to a tested, connected board: a short look at how Nanofab turns ideas into products.</p>
      <button type="button" class="reel-open btn btn-primary mt-8"><Icon name="Play" class="size-4" />Watch the showreel</button>
    </div>
    <div class="lg:col-span-7" data-reveal>
      <button type="button" class="reel-open group relative block w-full overflow-hidden rounded-panel border border-white/10 shadow-2xl shadow-black/60">
        <span class="sr-only">Play the Nanofab showreel, duration</span>
        <video class="aspect-video w-full object-cover opacity-80 transition group-hover:opacity-100" muted playsinline loop preload="none" poster="/videos/showreel-poster.jpg" data-preview>
          <source src="/videos/showreel.mp4" type="video/mp4" />
        </video>
        <span class="absolute inset-0 flex items-center justify-center">
          <span class="flex size-20 items-center justify-center rounded-full bg-signal-500 text-ink-950 shadow-[0_0_0_12px] shadow-signal-400/20 transition group-hover:scale-110"><Icon name="Play" class="ml-1 size-8" /></span>
        </span>
        <span class="absolute bottom-4 left-4 rounded-full bg-ink-950/80 px-3 py-1 font-mono text-xs text-fg-muted">0:22</span>
      </button>
    </div>
  </div>

  <dialog id="reel-modal" class="m-auto w-[min(1100px,94vw)] rounded-card bg-black p-0 backdrop:bg-ink-950/90" aria-label="Nanofab showreel">
    <form method="dialog" class="absolute top-3 right-3 z-10"><button class="rounded-full bg-white/10 p-2 text-white hover:bg-white/20" aria-label="Close video"><Icon name="X" class="size-5" /></button></form>
    <video class="aspect-video w-full" controls playsinline preload="none" poster="/videos/showreel-poster.jpg">
      <source src="/videos/showreel.mp4" type="video/mp4" />
    </video>
  </dialog>
</section>
<script>
  const modal = document.getElementById('reel-modal') as HTMLDialogElement | null;
  const full = modal?.querySelector('video');
  document.querySelectorAll('.reel-open').forEach((b) => b.addEventListener('click', () => {
    if (!modal || !full) return;
    modal.showModal(); full.currentTime = 0; full.play().catch(() => {});
    (window as any).nfTrack?.('video_play', { video: 'showreel' });
  }));
  modal?.addEventListener('close', () => full?.pause());
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  // Silent preview plays while the section is on screen (not with reduced motion)
  const prev = document.querySelector<HTMLVideoElement>('video[data-preview]');
  if (prev && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([e]) => { e.isIntersecting ? (prev.preload = 'auto', prev.play().catch(() => {})) : prev.pause(); }, { threshold: 0.3 }).observe(prev);
  }
</script>
