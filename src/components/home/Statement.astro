---
// "Who we are" + "Why Nanofab": large editorial statement (words light up on scroll),
// intro paragraph, and the six reasons to choose Nanofab.
import Icon from '../Icon.astro';
import { whyNanofab } from '@/data/site';
const text = 'We bring together engineering expertise, technology and manufacturing capabilities to transform ideas into reliable, production-ready electronic products.';
const highlight = new Set(['engineering', 'expertise,', 'manufacturing', 'production-ready']);
const words = text.split(' ');
---
<section class="section">
  <div class="container-x">
    <p class="eyebrow">Who we are</p>
    <p class="statement mt-8 max-w-5xl font-display text-[1.9rem] leading-[1.15] font-medium tracking-[-0.03em] text-fg sm:text-5xl lg:text-[3.6rem]" id="statement">
      {words.map((w) => <span class:list={['w', highlight.has(w) && 'hl']}>{w} </span>)}
    </p>
    <div class="mt-12 grid gap-8 border-t border-line pt-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-lg leading-relaxed text-fg-muted">
          Whether you are an established business developing its next product, a startup building a prototype, or an engineer looking for reliable
          manufacturing support, Nanofab provides the expertise and resources to help bring your ideas to life.
        </p>
        <a href="/about" class="btn btn-outline mt-6">More about Nanofab <Icon name="ArrowRight" class="size-4" /></a>
      </div>
      <div class="lg:col-span-7">
        <p class="font-mono text-xs tracking-[0.18em] text-fg-subtle uppercase">Why Nanofab?</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {whyNanofab.map((w) => (
            <li class="trace flex items-center gap-3 rounded-xl border border-line bg-surface p-4" data-reveal>
              <span class="icon-tile size-10"><Icon name={w.icon} class="size-5" /></span>
              <span class="font-medium text-fg">{w.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
<style>
  .js .statement .w { opacity: var(--o, 0.18); transition: opacity 0.2s linear; }
  .statement .hl { color: var(--color-accent); }
  @media (prefers-reduced-motion: reduce) { .js .statement .w { opacity: 1; } }
</style>
<script>
  const el = document.getElementById('statement');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...el.querySelectorAll<HTMLElement>('.w')];
    const update = () => {
      const r = el.getBoundingClientRect();
      // progress 0 → 1 as the paragraph travels from 85% to 35% of the viewport height
      const p = Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / (innerHeight * 0.5 + r.height * 0.6)));
      const lit = p * words.length;
      words.forEach((w, i) => w.style.setProperty('--o', String(Math.min(1, Math.max(0.18, lit - i + 0.18)))));
    };
    update();
    addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    addEventListener('resize', update);
  }
</script>
