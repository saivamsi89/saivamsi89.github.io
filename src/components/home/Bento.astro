---
import Icon from '../Icon.astro';
import Illo from './Illo.astro';
import { developmentProcess } from '@/data/site';
---
<section class="section bg-surface-2">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2 class="h-section mt-3">Engineering and manufacturing, under one roof.</h2>
      </div>
      <a href="/services" class="btn btn-outline shrink-0">View all services</a>
    </div>

    <div class="bento mt-12 grid gap-4 md:grid-cols-6">
      <!-- PCB: hero tile -->
      <a href="/services#pcb" class="tile trace group on-dark relative overflow-hidden rounded-panel bg-ink-900 p-7 ring-1 ring-white/10 md:col-span-4 md:row-span-2 sm:p-9" data-reveal>
        <div class="bg-grid absolute inset-0 opacity-50" aria-hidden="true"></div>
        <div class="relative flex h-full flex-col">
          <p class="font-mono text-xs tracking-[0.18em] text-copper-400 uppercase">01 · Core</p>
          <h3 class="mt-3 max-w-md font-display text-3xl text-white sm:text-4xl">PCB Design &amp; Manufacturing</h3>
          <p class="mt-3 max-w-md text-fg-muted">Schematic and multilayer layout through rigid and flex fabrication, stencils and assembly.</p>
          <Illo name="stack" class="my-6 h-48 sm:h-60 md:mt-auto" />
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-signal-400">Explore PCB services <Icon name="ArrowRight" class="size-4 transition group-hover:translate-x-1" /></span>
        </div>
      </a>

      <!-- Embedded -->
      <a href="/services#embedded" class="tile trace group card relative flex flex-col overflow-hidden rounded-panel p-7 md:col-span-2 md:row-span-2" data-reveal>
        <p class="font-mono text-xs tracking-[0.18em] text-accent-2 uppercase">02</p>
        <h3 class="mt-3 font-display text-2xl">Embedded Systems &amp; Firmware</h3>
        <p class="mt-2 text-sm text-fg-muted">Hardware, firmware and embedded Linux, integrated and debugged on real boards.</p>
        <Illo name="firmware" class="mx-auto my-6 h-44 w-44 md:my-auto" />
        <span class="inline-flex items-center gap-1 text-sm font-semibold text-accent">Learn more <Icon name="ArrowRight" class="size-4 transition group-hover:translate-x-1" /></span>
      </a>

      <a href="/services#iot" class="tile trace group card relative flex flex-col overflow-hidden rounded-panel p-7 md:col-span-2" data-reveal>
        <Illo name="wireless" class="mb-4 h-24" />
        <h3 class="font-display text-xl">IoT &amp; Intelligent Automation</h3>
        <p class="mt-2 text-sm text-fg-muted">Connected devices, sensing, remote monitoring and smart control.</p>
      </a>

      <a href="/resources/bom-upload" class="tile trace group card relative flex flex-col overflow-hidden rounded-panel p-7 md:col-span-2" data-reveal>
        <Illo name="reel" class="mb-4 h-24" />
        <h3 class="font-display text-xl">PCB Assembly &amp; Component Sourcing</h3>
        <p class="mt-2 text-sm text-fg-muted">Reliable assembly backed by sourcing support. Upload a BOM for a quote.</p>
      </a>

      <a href="/services#product" class="tile trace group card relative flex flex-col overflow-hidden rounded-panel p-7 md:col-span-2" data-reveal>
        <Illo name="schematic" class="mb-4 h-24" />
        <h3 class="font-display text-xl">Electronic Hardware Development</h3>
        <p class="mt-2 text-sm text-fg-muted">Robust hardware architecture and circuit design for real-world products.</p>
      </a>

      <!-- End-to-end -->
      <a href="/services#product" class="tile group relative overflow-hidden rounded-panel bg-gradient-to-br from-signal-500 to-signal-600 p-7 text-ink-950 md:col-span-6 sm:p-9" data-reveal>
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-md">
            <p class="font-mono text-xs tracking-[0.18em] uppercase opacity-70">End-to-End Product Development</p>
            <h3 class="mt-2 font-display text-3xl text-ink-950">One partner, idea to production.</h3>
          </div>
          <ol class="flex flex-wrap gap-2">
            {developmentProcess.map((s, i) => (
              <li class="rounded-full bg-ink-950/10 px-3 py-1.5 text-xs font-medium"><span class="font-mono opacity-60">{i + 1}</span> {s}</li>
            ))}
          </ol>
        </div>
      </a>
    </div>
  </div>
</section>
<style>
  @media (min-width: 768px) { .bento { grid-auto-rows: minmax(13rem, auto); } }
</style>
