---
import Icon from '../Icon.astro';
import { developmentProcess } from '@/data/site';

const cards = [
  { n: '02', icon: 'Cpu', title: 'Embedded Systems & Firmware', text: 'Hardware, firmware and embedded Linux, integrated and debugged on real boards.', href: '/services#embedded', span: 'md:col-span-2 md:row-span-2', big: true },
  { n: '03', icon: 'Wifi', title: 'IoT & Intelligent Automation', text: 'Connected devices, sensing, remote monitoring and smart control.', href: '/services#iot', span: 'md:col-span-2' },
  { n: '04', icon: 'Boxes', title: 'PCB Assembly & Component Sourcing', text: 'Reliable assembly backed by sourcing support. Upload a BOM for a quote.', href: '/resources/bom-upload', span: 'md:col-span-2' },
  { n: '05', icon: 'CircuitBoard', title: 'Electronic Hardware Development', text: 'Robust hardware architecture and circuit design for real-world products.', href: '/services#product', span: 'md:col-span-2' },
];
---
<section class="section bg-surface-2">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2 class="h-section mt-3">Engineering and manufacturing, under one roof.</h2>
      </div>
      <a href="/services" class="btn btn-outline shrink-0">View all services</a>
    </div>

    <div class="bento mt-12 grid gap-4 md:grid-cols-6">
      <!-- PCB: lead tile -->
      <a href="/services#pcb" class="tile fx trace group on-dark bg-grad-hero relative overflow-hidden rounded-panel p-7 md:col-span-4 md:row-span-2 sm:p-9" data-reveal>
        <div class="bg-grid absolute inset-0 opacity-50" aria-hidden="true"></div>
        <Icon name="CircuitBoard" class="fx-mark absolute -right-10 -bottom-10 size-72 text-white/[0.07]" strokeWidth={0.75} />
        <div class="relative flex h-full flex-col">
          <span class="fx-icon icon-tile size-16"><Icon name="CircuitBoard" class="size-8" /></span>
          <p class="mt-8 font-mono text-xs tracking-[0.18em] text-copper-400 uppercase">01 · Core</p>
          <h3 class="mt-3 max-w-md font-display text-3xl text-white sm:text-4xl">PCB Design &amp; Manufacturing</h3>
          <p class="mt-3 max-w-md text-fg-muted">Schematic and multilayer layout through rigid and flex fabrication, stencils and assembly.</p>
          <span class="mt-auto inline-flex items-center gap-1 pt-10 text-sm font-semibold text-signal-300">Explore PCB services <Icon name="ArrowRight" class="fx-arrow size-4" /></span>
        </div>
      </a>

      {cards.map((c) => (
        <a href={c.href} class:list={['tile fx trace group card relative flex flex-col overflow-hidden rounded-panel p-7', c.span]} data-reveal>
          <Icon name={c.icon} class:list={['fx-mark absolute -right-6 -bottom-6 text-accent opacity-[0.07]', c.big ? 'size-52' : 'size-32']} strokeWidth={1} />
          <div class="relative flex items-start justify-between">
            <span class="fx-icon icon-tile size-12"><Icon name={c.icon} class="size-6" /></span>
            <span class="font-mono text-xs text-accent-2">{c.n}</span>
          </div>
          <h3 class:list={['relative mt-6 font-display', c.big ? 'text-2xl' : 'text-xl']}>{c.title}</h3>
          <p class="relative mt-2 text-sm text-fg-muted">{c.text}</p>
          <span class="relative mt-auto inline-flex items-center gap-1 pt-6 text-sm font-semibold text-accent">Learn more <Icon name="ArrowRight" class="fx-arrow size-4" /></span>
        </a>
      ))}

      <!-- End-to-end -->
      <a href="/services#product" class="tile fx group relative overflow-hidden rounded-panel bg-gradient-to-br from-signal-400 to-signal-500 p-7 text-ink-950 md:col-span-6 sm:p-9" data-reveal>
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-md">
            <p class="font-mono text-xs tracking-[0.18em] uppercase opacity-70">End-to-End Product Development</p>
            <h3 class="mt-2 font-display text-3xl text-ink-950">One partner, idea to production.</h3>
          </div>
          <ol class="flex flex-wrap gap-2">
            {developmentProcess.map((s, i) => (
              <li class="step rounded-full bg-ink-900/10 px-3 py-1.5 text-xs font-medium" style={`--i:${i}`}><span class="font-mono opacity-60">{i + 1}</span> {s}</li>
            ))}
          </ol>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) { .bento { grid-auto-rows: minmax(13rem, auto); } }
  /* Hover (mouse) and keyboard-focus animations */
  .fx { transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(var(--ty, 0px)); transition: transform .25s ease, box-shadow .3s ease; }
  .fx:hover, .fx:focus-visible { --ty: -6px; box-shadow: 0 24px 40px -20px rgb(10 2 32 / .45); }
  .fx :global(.fx-icon), .fx :global(.fx-mark) { transition: transform .45s cubic-bezier(.3,1.5,.5,1), opacity .3s; }
  .fx:hover :global(.fx-icon), .fx:focus-visible :global(.fx-icon) { transform: rotate(-8deg) scale(1.15); }
  .fx:hover :global(.fx-mark), .fx:focus-visible :global(.fx-mark) { transform: translate(-14px, -14px) rotate(-10deg) scale(1.12); }
  .fx :global(.fx-arrow) { transition: transform .25s; }
  .fx:hover :global(.fx-arrow), .fx:focus-visible :global(.fx-arrow) { transform: translateX(7px); }
  .step { transition: transform .25s ease, background-color .25s; transition-delay: calc(var(--i) * 40ms); }
  .fx:hover .step { transform: translateY(-4px); background: rgb(255 255 255 / .55); }
  @media (prefers-reduced-motion: reduce) { .fx, .fx *, .step { transform: none !important; transition: none !important; } }
</style>

<script>
  // Cards tilt gently toward the mouse pointer.
  if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.bento .fx').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect(), max = r.width > 600 ? 2 : 5;
        el.style.setProperty('--ry', `${((e.clientX - r.left) / r.width - 0.5) * max}deg`);
        el.style.setProperty('--rx', `${(0.5 - (e.clientY - r.top) / r.height) * max}deg`);
      });
      el.addEventListener('pointerleave', () => { el.style.removeProperty('--rx'); el.style.removeProperty('--ry'); });
    });
  }
</script>
