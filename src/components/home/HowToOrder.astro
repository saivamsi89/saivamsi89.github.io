---
// How to order + the full instant-quote panel (PCB, Assembly, Stencil, Engineering).
import Icon from '../Icon.astro';
import QuotePanel from './QuotePanel.astro';
const steps = [
  { icon: 'FileUp', title: 'Share your files', text: 'Gerbers, BOM and pick-and-place files, or just an idea and a sketch.' },
  { icon: 'ScanSearch', title: 'Engineering review', text: 'We check manufacturability and component availability, then send your quote.' },
  { icon: 'Factory', title: 'Build', text: 'PCB fabrication, component sourcing and assembly, from prototypes to production runs.' },
  { icon: 'PackageCheck', title: 'Test & deliver', text: 'Boards are inspected and tested before they ship to you.' },
];
---
<section class="cv-auto section on-dark relative overflow-hidden bg-ink-900" data-spotlight>
  <div class="bg-grid absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="container-x relative grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6 xl:col-span-7">
      <p class="eyebrow">Start your project</p>
      <h2 class="h-section mt-3 text-white">Let&rsquo;s build something innovative together.</h2>
      <p class="lead mt-4">Four simple steps from your files, or just an idea, to finished boards.</p>
      <ol class="mt-10 space-y-6">
        {steps.map((s, i) => (
          <li class="flex gap-5" data-reveal>
            <div class="flex flex-col items-center">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-full border border-signal-400/30 bg-signal-400/10 text-signal-400"><Icon name={s.icon} class="size-5" /></span>
              {i < steps.length - 1 && <span class="mt-2 w-px flex-1 bg-gradient-to-b from-signal-400/40 to-transparent"></span>}
            </div>
            <div class="pb-2">
              <p class="font-mono text-xs text-copper-400">Step {i + 1}</p>
              <h3 class="mt-1 font-display text-xl text-white">{s.title}</h3>
              <p class="mt-1.5 text-fg-muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/resources/bom-upload" class="btn btn-outline"><Icon name="Upload" class="size-4" />Upload Your BOM</a>
        <span class="flex items-center gap-2 text-sm text-fg-subtle"><Icon name="Lock" class="size-4" />Files kept confidential</span>
      </div>
    </div>
    <div class="lg:col-span-6 xl:col-span-5">
      <div class="lg:sticky lg:top-28"><QuotePanel /></div>
    </div>
  </div>
</section>
