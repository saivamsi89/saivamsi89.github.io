---
interface Props { eyebrow?: string; title: string; lead?: string; center?: boolean; class?: string }
const { eyebrow, title, lead, center = false, class: cls = '' } = Astro.props;
---
<div class:list={['max-w-3xl', center && 'mx-auto text-center', cls]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="h-section mt-3" set:html={title} />
  {lead && <p class="lead mt-4">{lead}</p>}
  <slot />
</div>
