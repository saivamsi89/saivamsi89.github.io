---
// Certifications + testimonials. Renders nothing until data exists.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { trust } from '@/data/site';
import { certLogos } from '@/lib/assets';
const { certifications, testimonials } = trust;
---
{(certifications.length > 0 || testimonials.length > 0) && (
  <section class="section">
    <div class="container-x">
      {certifications.length > 0 && (
        <>
          <SectionHeader eyebrow="Quality & Certifications" title="Standards we work to" />
          <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {certifications.map((c) => (
              <li class="card flex items-center gap-4" data-reveal>
                {c.logo && certLogos[c.logo]
                  ? <Image src={certLogos[c.logo]} alt="" class="h-12 w-12 object-contain" />
                  : <span class="icon-tile"><Icon name="BadgeCheck" class="size-6" /></span>}
                <div><p class="font-semibold text-fg">{c.name}</p>{c.description && <p class="text-sm text-fg-subtle">{c.description}</p>}</div>
              </li>
            ))}
          </ul>
        </>
      )}
      {testimonials.length > 0 && (
        <div class:list={['grid gap-6 md:grid-cols-2', certifications.length > 0 && 'mt-16']}>
          {testimonials.map((t) => (
            <figure class="card p-8" data-reveal>
              <Icon name="Quote" class="size-8 text-signal-500" />
              <blockquote class="mt-4 text-lg leading-relaxed text-fg">{t.quote}</blockquote>
              <figcaption class="mt-5 text-sm"><span class="font-semibold text-fg">{t.name}</span><span class="text-fg-subtle">, {t.role}</span></figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>
)}
