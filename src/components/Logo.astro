---
// Official Nanofab logo, used exactly as supplied (only the surrounding white margin
// is trimmed). It has dark lettering on white, so always place it on a white surface.
import { Image } from 'astro:assets';
import logo from '@/assets/brand/nanofab-logo.jpg';
interface Props { class?: string }
const { class: cls = 'h-9' } = Astro.props;
---
<Image src={logo} alt="Nanofab" widths={[200, 400, 600]} sizes="200px" loading="eager" class:list={['w-auto', cls]} />
