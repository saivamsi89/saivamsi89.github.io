---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CheckList from '@/components/CheckList.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import CTABand from '@/components/CTABand.astro';
import { getCaseStudies } from '@/lib/content';

export async function getStaticPaths() {
  const all = await getCaseStudies();
  return all.map((cs) => ({ params: { slug: cs.id }, props: { cs, related: all.filter((o) => o.id !== cs.id && o.data.industry === cs.data.industry).slice(0, 3) } }));
}
const { cs, related } = Astro.props;
const { Content } = await render(cs);
const d = cs.data;
---
<BaseLayout title={d.title} description={d.summary} noindex={d.draft}>
  <PageHero eyebrow={`Case Study · ${d.industry}`} title={d.title} lead={d.summary} crumbs={[{ label: 'Case Studies', href: '/case-studies' }, { label: d.client }]}>
    <div class="mt-8 flex flex-wrap gap-2">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs text-white"><Icon name="Building2" class="size-3.5" />{d.client}</span>
      {d.services.map((s) => <span class="rounded-full border border-white/15 px-3 py-1 text-xs text-fg-muted">{s}</span>)}
    </div>
  </PageHero>

  {d.metrics.length > 0 && (
    <section class="border-b border-line py-10">
      <dl class="container-x grid grid-cols-2 gap-6 md:grid-cols-4">
        {d.metrics.map((m) => <div><dd class="text-3xl font-semibold text-fg">{m.value}</dd><dt class="mt-1 text-sm text-fg-subtle">{m.label}</dt></div>)}
      </dl>
    </section>
  )}

  <section class="section">
    <div class="container-x">
      {d.cover && <Image src={d.cover} alt={d.title} widths={[800, 1280, 1600]} sizes="(min-width: 1280px) 1216px, 100vw" class="mb-14 aspect-[21/9] w-full rounded-panel object-cover" />}
      <div class="grid gap-6 md:grid-cols-3">
        <div class="card" data-reveal>
          <span class="icon-tile"><Icon name="Target" class="size-5" /></span>
          <h2 class="mt-4 text-lg">The challenge</h2>
          <p class="mt-2 text-sm leading-relaxed text-fg-muted">{d.challenge}</p>
        </div>
        <div class="card" data-reveal>
          <span class="icon-tile"><Icon name="Wrench" class="size-5" /></span>
          <h2 class="mt-4 text-lg">Our solution</h2>
          <p class="mt-2 text-sm leading-relaxed text-fg-muted">{d.solution}</p>
        </div>
        <div class="on-dark card border-ink-800 bg-ink-900" data-reveal>
          <span class="icon-tile"><Icon name="TrendingUp" class="size-5" /></span>
          <h2 class="mt-4 text-lg text-white">The result</h2>
          <div class="mt-3 text-fg-body">{d.results.length ? <CheckList items={d.results} /> : <p class="text-sm">Details available on request.</p>}</div>
        </div>
      </div>
      <div class="prose-nf mx-auto mt-14"><Content /></div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section bg-surface-2">
      <div class="container-x">
        <h2 class="h-section">More from {d.industry}</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">{related.map((r) => <CaseStudyCard cs={r} />)}</div>
      </div>
    </section>
  )}
  <CTABand title="Have a similar challenge?" text="Tell us about your project. We'll share how we'd approach it." />
</BaseLayout>
