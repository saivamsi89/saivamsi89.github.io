---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { credits } from '@/data/credits';
---
<BaseLayout title="Image Credits" description="Credits and licences for third-party images used on the Nanofab Innovations website.">
  <PageHero eyebrow="Legal" title="Image Credits" lead="Sources and licences of third-party imagery used on this website." crumbs={[{ label: 'Image Credits' }]} />
  <section class="section">
    <div class="container-x">
      <div class="overflow-x-auto rounded-card border border-line">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface-2 font-mono text-2xs tracking-[0.14em] text-fg-muted uppercase">
            <tr><th class="px-5 py-3">Image</th><th class="px-5 py-3">Author</th><th class="px-5 py-3">Licence</th><th class="px-5 py-3">Changes</th></tr>
          </thead>
          <tbody class="divide-y divide-line">
            {credits.map((c) => (
              <tr>
                <td class="px-5 py-4">{c.source ? <a href={c.source} class="font-medium text-accent underline underline-offset-2" rel="noopener" target="_blank">{c.title}</a> : <span class="font-medium text-fg">{c.title}</span>}</td>
                <td class="px-5 py-4 text-fg-body">{c.author}</td>
                <td class="px-5 py-4 text-fg-body">{c.licenseUrl ? <a href={c.licenseUrl} class="text-accent underline underline-offset-2" rel="noopener" target="_blank">{c.license}</a> : c.license}</td>
                <td class="px-5 py-4 text-fg-muted">{c.changes ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm text-fg-subtle">Illustrations, icons and animations not listed here are original to this website.</p>
    </div>
  </section>
</BaseLayout>
