---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import CTABand from '@/components/CTABand.astro';
import { getProducts } from '@/lib/content';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}
const { product } = Astro.props;
const { Content } = await render(product);
const d = product.data;
const enquire = `/contact?service=${encodeURIComponent('Products & Quotation')}&product=${encodeURIComponent(d.name)}`;
const images = [d.image, ...d.gallery].filter((i): i is NonNullable<typeof i> => !!i);
// Pre-generate the large version of each image for the thumbnail switcher.
const large = await Promise.all(images.map((i) => getImage({ src: i, width: 1200, format: 'webp' })));
const ogImage = images[0] ? (await getImage({ src: images[0], width: 1200, format: 'jpg' })).src : undefined;
---
<BaseLayout title={d.name} description={d.summary} image={ogImage} noindex={d.draft}>
  <PageHero eyebrow={d.category} title={d.name} lead={d.summary} crumbs={[{ label: 'Products', href: '/products' }, { label: d.name }]}>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={enquire} class="btn btn-primary">Request a Quote <Icon name="ArrowRight" class="size-4" /></a>
      {d.datasheet ? (
        <a href={d.datasheet} class="btn btn-outline" download><Icon name="Download" class="size-4" />Download Datasheet</a>
      ) : (
        <a href={enquire} class="btn btn-outline"><Icon name="Download" class="size-4" />Request Datasheet</a>
      )}
    </div>
  </PageHero>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-card border border-line bg-surface-2">
          {images.length ? (
            <Image id="main-img" src={images[0]} alt={d.name} widths={[600, 900, 1200]} sizes="(min-width: 1024px) 58vw, 100vw" loading="eager" class="aspect-[4/3] w-full object-cover" />
          ) : (
            <div class="bg-grid-light flex aspect-[4/3] items-center justify-center text-fg-faint"><Icon name="Cpu" class="size-24" strokeWidth={1} /></div>
          )}
        </div>
        {images.length > 1 && (
          <div class="mt-3 grid grid-cols-5 gap-3">
            {images.map((img, i) => (
              <button type="button" class="thumb overflow-hidden rounded-control border border-line" data-src={large[i].src} aria-label={`Show image ${i + 1}`}>
                <Image src={img} alt="" width={160} class="aspect-square w-full object-cover" />
              </button>
            ))}
          </div>
        )}
        <div class="prose-nf mt-10"><h2>Product overview</h2><Content /></div>
      </div>

      <aside class="space-y-6 lg:col-span-5">
        <div class="card p-0">
          <h2 class="border-b border-line px-6 py-4 text-base">Technical specifications</h2>
          {d.specs.length ? (
            <dl class="divide-y divide-line">
              {d.specs.map((s) => (
                <div class="grid grid-cols-5 gap-4 px-6 py-3 text-sm">
                  <dt class="col-span-2 text-fg-subtle">{s.label}</dt>
                  <dd class="col-span-3 font-medium text-fg">{s.value}</dd>
                </div>
              ))}
            </dl>
          ) : <p class="px-6 py-4 text-sm text-fg-subtle">Specifications available on request.</p>}
        </div>

        {d.configurations.length > 0 && (
          <div class="card">
            <h2 class="text-base">Available configurations</h2>
            <div class="mt-4 flex flex-wrap gap-2">{d.configurations.map((c) => <span class="chip">{c}</span>)}</div>
          </div>
        )}

        <div class="on-dark card border-ink-800 bg-ink-900">
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-fg-subtle">Pricing</p>
          <p class="mt-2 text-2xl font-semibold text-white">{d.price ?? 'Price on request'}</p>
          <p class="mt-2 text-sm text-fg-subtle">Volume pricing and custom configurations available.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={enquire} class="btn btn-primary">Request a Quote</a>
            <a href={enquire} class="btn btn-outline">Product Enquiry</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<script>
  const main = document.getElementById('main-img') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((b) => b.addEventListener('click', () => { if (main) { main.removeAttribute('srcset'); main.src = b.dataset.src!; } }));
</script>
