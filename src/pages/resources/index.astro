---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CTABand from '@/components/CTABand.astro';
import { getPosts, formatDate } from '@/lib/content';

const posts = (await getPosts()).slice(0, 3);
const hubs = [
  { icon: 'BookOpen', title: 'Engineering Blogs', href: '/resources/blog', cta: 'Read the blog', text: 'Explore articles, technical insights and updates covering PCB design, embedded systems, IoT, electronics manufacturing and emerging technologies.' },
  { icon: 'CircleHelp', title: 'Frequently Asked Questions', href: '/resources/faq', cta: 'Browse FAQs', text: 'Find answers to common questions about PCB manufacturing, fabrication, assembly, component sourcing and embedded product development.' },
  { icon: 'Upload', title: 'BOM Upload & Quotation Tool', href: '/resources/bom-upload', cta: 'Upload Your BOM', text: 'Simplify your component sourcing process. Upload your Bill of Materials for availability checks and quotation assistance.' },
];
---
<BaseLayout title="Resources" description="Engineering blogs, FAQs and the BOM Upload & Quotation tool from Nanofab Innovations.">
  <PageHero
    eyebrow="Resources"
    title="Knowledge, Tools &amp; Engineering Resources"
    lead="Access useful engineering resources, technical information and tools designed to support electronics professionals and businesses."
    crumbs={[{ label: 'Resources' }]}
  />
  <section class="section">
    <div class="container-x grid gap-6 lg:grid-cols-3">
      {hubs.map((h, i) => (
        <a href={h.href} class:list={['card card-hover group flex flex-col p-8', i === 2 && 'on-dark border-ink-800 bg-ink-900']} data-reveal>
          <span class="icon-tile size-12"><Icon name={h.icon} class="size-6" /></span>
          <h2 class:list={['mt-6 text-xl', i === 2 && 'text-white']}>{h.title}</h2>
          <p class:list={['mt-3 text-sm leading-relaxed', i === 2 ? 'text-fg-muted' : 'text-fg-muted']}>{h.text}</p>
          <span class:list={['mt-auto inline-flex items-center gap-1 pt-6 text-sm font-semibold', i === 2 ? 'text-signal-400' : 'text-accent']}>
            {h.cta}<Icon name="ArrowRight" class="size-4 transition group-hover:translate-x-1" />
          </span>
        </a>
      ))}
    </div>
  </section>
  {posts.length > 0 && (
    <section class="section bg-surface-2">
      <div class="container-x">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <SectionHeader eyebrow="Latest from the blog" title="Engineering insights" />
          <a href="/resources/blog" class="btn btn-outline shrink-0">All articles</a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {posts.map((p) => (
            <a href={`/resources/blog/${p.id}`} class="card card-hover flex flex-col" data-reveal>
              <p class="font-mono text-xs text-fg-subtle">{formatDate(p.data.date)}</p>
              <h3 class="mt-3 text-lg">{p.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-sm text-fg-muted">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <CTABand />
</BaseLayout>
