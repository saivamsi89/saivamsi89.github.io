---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { getPosts, formatDate } from '@/lib/content';
const posts = await getPosts();
---
<BaseLayout title="Engineering Blog" description="Articles, technical insights and updates on PCB design, embedded systems, IoT, electronics manufacturing and emerging technologies.">
  <PageHero
    eyebrow="Engineering Blogs"
    title="Insights from the engineering floor"
    lead="Explore articles, technical insights and updates covering PCB design, embedded systems, IoT, electronics manufacturing and emerging technologies."
    crumbs={[{ label: 'Resources', href: '/resources' }, { label: 'Blog' }]}
  />
  <section class="section">
    <div class="container-x">
      {posts.length ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((p) => (
            <a href={`/resources/blog/${p.id}`} class="card card-hover group flex flex-col" data-reveal>
              <div class="flex flex-wrap gap-2">{p.data.tags.map((t) => <span class="chip">{t}</span>)}</div>
              <h2 class="mt-4 text-xl">{p.data.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{p.data.description}</p>
              <div class="mt-auto flex items-center justify-between pt-6 text-xs text-fg-subtle">
                <span class="font-mono">{formatDate(p.data.date)}</span>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-accent">Read <Icon name="ArrowRight" class="size-4 transition group-hover:translate-x-1" /></span>
              </div>
            </a>
          ))}
        </div>
      ) : <p class="text-fg-subtle">Articles coming soon.</p>}
    </div>
  </section>
</BaseLayout>
