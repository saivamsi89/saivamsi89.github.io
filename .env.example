# Where the Contact and BOM forms POST to (multipart/form-data).
# e.g. https://formspree.io/f/xxxxxxx or your own API endpoint.
# Leave empty to show a "form not yet connected" notice on submit.
PUBLIC_FORM_ENDPOINT=

# Analytics (optional). One of: plausible | ga4 | (empty = none)
PUBLIC_ANALYTICS=
# Plausible (cookieless, no consent banner): your site's domain
PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: self-hosted Plausible script URL
PUBLIC_PLAUSIBLE_SRC=
# Google Analytics 4 measurement ID (loaded only after the visitor accepts cookies)
PUBLIC_GA4_ID=

# Site mode: "preview" (default: noindex everywhere, robots.txt disallows all) or "production" (indexable)
PUBLIC_SITE_MODE=preview
# Public address of the deployed site (used for canonical URLs, sitemap, social cards)
SITE_URL=
# Sub-folder if served from one, e.g. /nanofab-website (leave empty when served from a domain root)
BASE_PATH=
